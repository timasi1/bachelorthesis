@article{Zhao:20,
author = {Ran Zhao and Guo-Da Xie and Menglin L. N. Chen and Zhihao Lan and Zhixiang Huang and Wei E. I. Sha},
journal = {Opt. Express},
keywords = {Composite materials; Curvature; Dispersion; Material properties; Photonic crystals; Thulium},
number = {4},
pages = {4638--4649},
publisher = {Optica Publishing Group},
title = {First-principle calculation of Chern number in gyrotropic photonic crystals},
volume = {28},
month = {Feb},
year = {2020},
url = {https://opg.optica.org/oe/abstract.cfm?URI=oe-28-4-4638},
doi = {10.1364/OE.380077},
abstract = {As an important figure of merit for characterizing the quantized collective behaviors of the wavefunction, Chern number is the topological invariant of quantum Hall insulators. Chern number also identifies the topological properties of the photonic topological insulators (PTIs), thus it is of crucial importance in PTI design. In this paper, we develop a first principle computatioal method for the Chern number of 2D gyrotropic photonic crystals (PCs), starting from the Maxwell\&\#x2019;s equations. Firstly, we solve the Hermitian generalized eigenvalue equation reformulated from the Maxwell\&\#x2019;s equations by using the full-wave finite-difference frequency-domain (FDFD) method. Then the Chern number is obtained by calculating the integral of Berry curvature over the first Brillouin zone. Numerical examples of both transverse-electric (TE) and transverse-magnetic (TM) modes are demonstrated, where convergent Chern numbers can be obtained using rather coarse grids, thus validating the efficiency and accuracy of the proposed method.},
}


